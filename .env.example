# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to git.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=ack_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=acknowledgement

# --- LDAP / Active Directory ---
LDAP_SERVER=CHANGE_ME_LDAP_SERVER_IP_OR_HOSTNAME
LDAP_BIND_DN=CN=training,OU=Services Users,OU=Priveleged Accounts,DC=corp,DC=agrobank,DC=uz
LDAP_PASSWORD=CHANGE_ME_AD_SERVICE_ACCOUNT_PASSWORD
LDAP_BASE_DN=DC=corp,DC=agrobank,DC=uz
# UPN suffix — users bind by their own login as sAMAccountName@LDAP_DOMAIN
LDAP_DOMAIN=corp.agrobank.uz

# --- Mode / Locale ---
# MUST be false in production (true enables a dev login bypass)
DEV_MODE=false
# Display timezone offset from UTC (Tashkent/Ashgabat = 5, no DST)
TZ_OFFSET_HOURS=5

# --- Application Security ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING

# --- Admin Panel ---
ADMIN_USERNAME=CHANGE_ME_STRONG_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
ADMIN_SESSION_HOURS=8

# --- Limits (optional — defaults shown) ---
MAX_FILE_SIZE_MB=100
MAX_DECLINE_ATTEMPTS=3
SCROLL_THRESHOLD=0.80
MIN_VIEW_SECONDS=20
